# Runtime environment: local, development, staging, or production
ENVIRONMENT=local
LOG_LEVEL=INFO

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173"]

# Database. Supply your Supabase PostgreSQL connection string when a database is introduced.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/repomind

# Repository ingestion workspace
GIT_EXECUTABLE=git
INGESTION_MAX_FILE_SIZE_BYTES=1048576

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1

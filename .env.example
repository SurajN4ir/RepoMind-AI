# Runtime environment: local, development, staging, or production
ENVIRONMENT=local
LOG_LEVEL=INFO

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_PREFIX=/api
CORS_ORIGINS=["http://localhost:3000"]

# Database
# ---------
# This default targets the `postgres` service that `docker compose up` starts
# for you (pgvector-enabled, credentials below). It only resolves from inside
# the Compose network -- running the backend natively (not via Docker), point
# this at localhost instead, e.g.:
#   DATABASE_URL=postgresql+psycopg://repomind:repomind@localhost:5432/repomind
#
# To use a hosted PostgreSQL/Supabase database instead, replace the whole
# value with your Supabase connection string; nothing else needs to change,
# since the local `postgres` Compose service is simply unused in that case.
DATABASE_URL=postgresql+psycopg://repomind:repomind@postgres:5432/repomind

# Credentials for the local `postgres` Compose service only (see above).
# Not used at all when DATABASE_URL points elsewhere (e.g. Supabase).
POSTGRES_USER=repomind
POSTGRES_PASSWORD=repomind
POSTGRES_DB=repomind

# Embeddings and response generation (Ollama). Pull both models first:
#   ollama pull all-minilm:l6-v2
#   ollama pull llama3.2
# embedding_dimensions must match the embedding model's output width --
# changing to a model with a different width requires a new Alembic migration
# to resize the pgvector column (see
# backend/alembic/versions/0008_pgvector_embedding_column.py).
#
# host.docker.internal reaches Ollama running on your host machine from
# inside the backend container (RepoMind does not containerize Ollama).
# Running the backend natively instead of via Docker, use localhost:11434.
EMBEDDING_MODEL=all-minilm:l6-v2
EMBEDDING_BASE_URL=http://host.docker.internal:11434
EMBEDDING_DIMENSIONS=384
GENERATION_MODEL=llama3.2
GENERATION_BASE_URL=http://host.docker.internal:11434

# Repository ingestion workspace
GIT_EXECUTABLE=git
INGESTION_MAX_FILE_SIZE_BYTES=1048576

# Frontend (read by frontend/services/api-client.ts)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Frontend auth (Clerk). Without real values, the frontend container starts
# but every page 500s ("Missing publishableKey"). Get keys at
# https://dashboard.clerk.com -- do not commit real values here.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=

# Backend auth (Clerk JWT verification, see backend/app/modules/auth/).
# Without CLERK_JWKS_URL, every authenticated request fails with a 500
# ("CLERK_JWKS_URL is not configured"). Must point at the *same* Clerk
# instance as the two frontend keys above. Find both values on your Clerk
# instance's "API Keys" > "Advanced" page:
#   CLERK_JWKS_URL   = https://<your-instance>.clerk.accounts.dev/.well-known/jwks.json
#   CLERK_ISSUER     = https://<your-instance>.clerk.accounts.dev
# CLERK_ISSUER is optional (verification skips the issuer check when unset),
# but setting it is recommended.
# CLERK_JWKS_URL=
# CLERK_ISSUER=
